<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for all HTTP/HTTPS calls to PIA APIs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for TCP latency probes and API calls -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Google Play Billing. Declared BEFORE any billing code exists, because Play will not let you
         create a one-time product until it has seen an uploaded artifact asking for this. The SDK
         declares it too; identical uses-permission entries merge, so both can stand. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Required to write config files to external/shared storage if user chooses -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="cfg-pia-wg"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:exported="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ID-376: the two home-screen widgets. All the deciding happens in Dart; these receivers
             only draw whatever lib/widget_bridge.dart last wrote. -->
        <!-- exported="true": the update broadcast comes from the system's widget host, a
             different UID, matching home_widget's own example manifest. -->
        <receiver android:name=".widget.TunnelsWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tunnels_info" />
        </receiver>
        <receiver android:name=".widget.CompactWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- The refresh button. exported="false": only the widget's own PendingIntent, which
             names this class, ever sends it anything. -->
        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false" />
    </application>
</manifest>
