<?xml version="1.0" encoding="utf-8"?>
<!-- ID-376: the widget's own rounded card, matching the app's dark screens. RemoteViews cannot
     draw a shadow or a true card elevation, so this is colour and a 1dp border only. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <stroke android:width="1dp" android:color="@color/widget_card_border" />
    <corners android:radius="24dp" />
</shape>
