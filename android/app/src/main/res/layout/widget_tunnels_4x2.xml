<?xml version="1.0" encoding="utf-8"?>
<!-- ID-376: the 4x2 widget. RemoteViews only - no custom views, no ConstraintLayout, nothing that
     needs AppCompat to inflate in the launcher's process. Mirrors TunnelDown.dc.html and
     NotChecked.dc.html from the mock-up (https://claude.ai/artifact/SU6ha7UoqcczLr1d2f6oLn), with
     up to 2 tunnel rows shown directly and any further slot folded into tv_overflow - the app
     supports up to 5, but every example seen so far runs 1 or 2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="14dp">

    <!-- Header: the app, and the overall badge. Exactly one of the three badge_* rows is visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="cfg-pia-wg"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/badge_protected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_protected_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_widget_shield" android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="Protected"
                android:textColor="@color/widget_teal" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/badge_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_down_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_widget_warning" android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_badge_down_text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" tools:text="1 tunnel down"
                android:textColor="@color/widget_amber" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/badge_unchecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_unchecked_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:visibility="gone">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/ic_widget_clock" android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="Not checked"
                android:textColor="@color/widget_grey" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tunnel row 1 -->
    <LinearLayout
        android:id="@+id/row1_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView android:id="@+id/dot_row1" android:layout_width="10dp" android:layout_height="10dp"
            android:src="@drawable/widget_dot_unchecked" android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/tv_row1_region" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/tv_row1_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/tv_row1_guard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_teal" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tunnel row 2 -->
    <LinearLayout
        android:id="@+id/row2_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView android:id="@+id/dot_row2" android:layout_width="10dp" android:layout_height="10dp"
            android:src="@drawable/widget_dot_unchecked" android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/tv_row2_region" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/tv_row2_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/tv_row2_guard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_teal" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_overflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/tv_last_checked"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_badge_refresh_bg_none"
            android:src="@drawable/ic_widget_refresh_plain"
            android:scaleType="center"
            android:contentDescription="Check the router now" />
    </LinearLayout>
</LinearLayout>
